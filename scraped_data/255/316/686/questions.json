    "title": "বাংলাদেশকে সবচেয়ে বেশি ঋণ প্রদানকারী দেশ কোনটি?",
    "description": null,
    "author_id": "0",
    "is_paid": "0",
    "is_featured": "0",
    "type": "mcq",
    "mark": "1.00",
    "status": "0",
