      {
        "id": 79724,
        "question_id": "19976",
        "mcq_option_serial": "1",
        "mcq_question_text": "১০ জানুয়ারি ১৯৭২",
        "mcq_images": null,
        "is_correct": "1",
        "description": "<p>বঙ্গবন্ধু শেখ মুজিবুর রহমান স্বদেশ প্রত্যাবর্তন করেন ১৯৭২ সালের ১০ জানুয়ারি। এর আগে পাকিস্তানের লাহোর থেকে প্রায় ৮০ মাইল দূরে লায়ালপুর শহরের মিয়ানওয়ালি কারাগারে বন্দি ছিলেন। পাকিস্তানের কারাগার থেকে ফিরে লন্ডন যান। এরপর দিল্লিতে ভারতের তৎকালীন প্রধানমন্ত্রী মিসেস ইন্দিরা গান্ধীর সঙ্গে সাক্ষাৎ করে ঢাকায় প্রত্যাবর্তন করেন।</p>",
        "created_at": "2025-04-10T11:59:08.000000Z",
        "updated_at": "2025-04-10T11:59:08.000000Z"
      },
