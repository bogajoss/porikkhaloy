      {
        "id": 75265,
        "question_id": "18865",
        "mcq_option_serial": "1",
        "mcq_question_text": "লুইস ব্রাউন",
        "mcq_images": null,
        "is_correct": "1",
        "description": "১৯৭৮ সালে ২৫ জুলাই ইংল্যান্ডের ম্যানচেষ্টারে গুল্ডহ্যাম এন্ড জেনারেল হসপিটালে বিশ্বের প্রথম টেস্টটিউব বেবির জন্ম হয়; যার নাম রাখা হয় লুইস ব্রাউন। টেস্টটিউব পদ্ধতির মাধ্যমে জন্মগ্রহণের এই পদ্ধতিকে বলা হয় ইন-ডিট্রো ফার্টিলাইজেশন বা আইভিএফ; যার জনক হলেন অধ্যাপক রবার্ট জি এডওয়ার্ডস। উল্লেখ্য যে, বাংলাদেশে প্রথম টেস্টটিউব বেবির জন্ম হয় ২০০১ সালের ২৯ মে যাদের নাম হিরা, মণি ও মুক্তা।",
        "created_at": "2025-04-08T18:15:02.000000Z",
        "updated_at": "2025-04-08T18:15:02.000000Z"
