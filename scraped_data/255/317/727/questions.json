      {
        "id": 75304,
        "question_id": "18874",
        "mcq_option_serial": "2",
        "mcq_question_text": "১ জুলাই",
        "mcq_images": null,
        "is_correct": "0",
        "description": null,
        "created_at": "2025-04-08T18:22:33.000000Z",
        "updated_at": "2025-04-08T18:22:33.000000Z"
      },
      {
        "id": 75305,
        "question_id": "18874",
        "mcq_option_serial": "3",
        "mcq_question_text": "৩১ মে",
        "mcq_images": null,
        "is_correct": "1",
        "description": "<p>বিশ্ব তামাকমুক্ত দিবস (World No Tobacco Day): প্রতি বছর ৩১ মে তারিখে বিশ্বজুড়ে বিশ্ব তামাকমুক্ত দিবস পালন করা হয়। বিশ্বজুড়ে ২৪ ঘণ্টা সময়সীমা ধরে তামাক সেবনের সমস্ত প্রক্রিয়া থেকে বিরত থাকাতে উৎসাহিত করার উদ্দেশ্যে দিবসটি প্রচলিত হয়েছে। এছাড়াও দিবসটির উদ্দেশ্য হলো তামাক ব্যবহারের ব্যাপক প্রাদুর্ভাব এবং স্বাস্থ্যের নেতিবাচক প্রভাবের প্রতি দৃষ্টি আকর্ষণ যা বর্তমানে প্রতি বছর বিশ্বব্যাপী প্রায় ৬০ লক্ষ মানুষের মৃত্যুর কারণ হিসেবে বিবেচিত। বিশ্ব স্বাস্থ্য সংস্থা (WHO)'র সদস্য রাষ্ট্রসমূহ ১৯৮৭ সাল থেকে বিশ্ব তামাকমুক্ত দিবস চালু করে।</p>",
        "created_at": "2025-04-08T18:22:33.000000Z",
        "updated_at": "2025-04-08T18:22:33.000000Z"
      },
      {
