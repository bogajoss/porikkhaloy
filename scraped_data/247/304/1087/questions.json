      {
        "id": 331216,
        "question_id": "82773",
        "mcq_option_serial": "1",
        "mcq_question_text": "my, her",
        "mcq_images": null,
        "is_correct": "0",
        "description": null,
        "created_at": "2025-12-28T07:49:44.000000Z",
