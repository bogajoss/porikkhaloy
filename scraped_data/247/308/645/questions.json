    "id": 44444,
    "title": "Which of the following uses of the preposition 'but is correct?",
    "description": null,
    "author_id": "0",
    "is_paid": "0",
    "is_featured": "0",
    "type": "mcq",
    "mark": "1.00",
    "status": "0",
    "created_at": "2025-06-29T02:32:44.000000Z",
    "updated_at": "2025-06-29T02:32:44.000000Z",
    "tags": "87,62,92",
    "creative_questions": [],
    "mcq_questions": [
      {
        "id": 177566,
        "question_id": "44444",
        "mcq_option_serial": "1",
        "mcq_question_text": "I am sure no one but he would do such a thing.",
        "mcq_images": null,
        "is_correct": "1",
        "description": "<p> ব্যতীত বা ছাড়া অর্থে everyone, nobody, anything, all, no one ইত্যাদির পরে \"but\" preposition হিসেবে ব্যবহৃত হয়। সে ক্ষেত্রে but এর পরে noun বা noun phrase ব্যবহৃত হয়।</p>",
        "created_at": "2025-06-29T02:32:44.000000Z",
        "updated_at": "2025-06-29T02:32:44.000000Z"
      },
      {
        "id": 177567,
        "question_id": "44444",
        "mcq_option_serial": "2",
        "mcq_question_text": "He does not seem to be interested in anything but play with toys.",
        "mcq_images": null,
        "is_correct": "0",
        "description": null,
        "created_at": "2025-06-29T02:32:44.000000Z",
        "updated_at": "2025-06-29T02:32:44.000000Z"
      },
      {
        "id": 177568,
        "question_id": "44444",
        "mcq_option_serial": "3",
        "mcq_question_text": "I cannot but to admire the beauty of the mountain summit.",
        "mcq_images": null,
        "is_correct": "0",
        "description": null,
        "created_at": "2025-06-29T02:32:44.000000Z",
        "updated_at": "2025-06-29T02:32:44.000000Z"
      },
      {
        "id": 177569,
        "question_id": "44444",
        "mcq_option_serial": "4",
        "mcq_question_text": "There is no alternative but to walk all the way home",
        "mcq_images": null,
        "is_correct": "0",
        "description": null,
        "created_at": "2025-06-29T02:32:44.000000Z",
        "updated_at": "2025-06-29T02:32:44.000000Z"
