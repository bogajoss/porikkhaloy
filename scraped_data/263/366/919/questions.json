      {
        "id": 330780,
        "question_id": "82669",
        "mcq_option_serial": "3",
        "mcq_question_text": "রবীন্দ্রনাথ ঠাকুর",
        "mcq_images": null,
        "is_correct": "1",
        "description": "<p> 'বিশ্বকবি' অভিধায় ভূষিত রবীন্দ্রনাথ ঠাকুর জন্মগ্রহণ করেন ৭ মে ১৮৬১ খ্রিষ্টাব্দে। তার পিতার নাম মহর্ষি দেবেন্দ্রনাথ ঠাকুর। আর মাতার নাম সারদা দেবী। বাংলা সাহিত্যের ছোটগল্প, ছড়া, কবিতা, কাব্য, উপন্যাস, প্রবন্ধে তার কীর্তি অনন্য ভূমিকা রেখেছে। ৭ই আগষ্ট ১৯৪১ খ্রিষ্টাব্দে এ মহান কবির জীবনবশান হয়।</p>",
        "created_at": "2025-12-28T05:22:43.000000Z",
        "updated_at": "2025-12-28T05:22:43.000000Z"
      },
